# --- LLM (Vertex AI) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=                      # GCP project ID
GOOGLE_CLOUD_LOCATION=asia-southeast1      # Vertex AI region

# --- MCP ---
MCP_SERVER_URL=http://localhost:8080/mcp   # Local dev; Cloud Run URL in prod

# --- A2A ---
A2A_PORT=10000

# --- Model Armor ---
MODEL_ARMOR_TEMPLATE_ID=anikrewe-safety
MODEL_ARMOR_LOCATION=asia-southeast1       # Must match Vertex AI region

# --- Feature Flags ---
ADK_INCLUDE_THOUGHTS=true
ENABLE_MODEL_ARMOR=true                    # Set false to skip Model Armor (LLM Judge only)
